# Copiar para .env (não versionado) e ajustar. Nunca colocar valores reais neste ficheiro.
NODE_ENV=development
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=info

# Provedor esportivo de testes (DT-009): Sportsbook API no RapidAPI.
# Valores reais só no .env local. Sem chave, as rotas /api/competitions e /api/events dão 503.
SPORTS_PROVIDER_API_KEY=
# Opcionais (valores por omissão entre parênteses):
# host da RapidAPI (sportsbook-api2.p.rapidapi.com)
SPORTS_PROVIDER_HOST=
# fonte única das odds, DT-010 (BET_PARX)
SPORTS_PROVIDER_SOURCE=
# nomes curtos separados por vírgula, DT-012 (EPL,LA_LIGA,SERIE_A)
SPORTS_COMPETITIONS=
# minutos entre atualizações de cada competição, DT-012 (60)
SPORTS_REFRESH_MINUTES=

# Modo de teste da api (DT-018). Com `recorded`, a api serve as respostas gravadas de
# apps/api/recordings/ — sem chave, sem chamadas ao provedor e sem gastar quota. É o modo
# dos testes end-to-end. `live` (omissão) chama o provedor real.
# live | recorded (live)
SPORTS_MODE=
# Só com SPORTS_MODE=recorded: instante ISO em que o relógio fica parado.
# Por omissão, o `recordedAt` da gravação, com que todos os jogos gravados estão por começar.
SPORTS_NOW=

# Limite de pedidos por cliente (S-1, DT-019). A cache protege a quota do provedor,
# não a api: um cliente só já basta para a sobrecarregar.
# pedidos por janela; 0 desliga o limite (300)
RATE_LIMIT_MAX=
# duração da janela, em segundos (60)
RATE_LIMIT_WINDOW_SECONDS=

# Endurecimento da api (S-3, DT-020).
# origens autorizadas a chamar a api de outro sítio, separadas por vírgula.
# Vazio = nenhuma. Em desenvolvimento o Vite encaminha /api, logo é a mesma origem.
CORS_ORIGINS=
# teto do corpo de um pedido, em bytes (65536)
BODY_LIMIT_BYTES=

# Contas e sessões (DT-020, DT-021). Sem DATABASE_FILE não há rotas de conta.
# caminho do ficheiro SQLite, ex.: data/blbet.db
DATABASE_FILE=
# segredo com que os endereços IP são resumidos antes de guardados.
# Obrigatório com DATABASE_FILE; pelo menos 32 caracteres. Valor real só no .env local.
AUTH_IP_HASH_SECRET=
# nome do cookie de sessão (blbet_session)
SESSION_COOKIE_NAME=
# minutos de inatividade até a sessão morrer (60)
SESSION_IDLE_MINUTES=
# teto absoluto da sessão, em horas, que o uso contínuo não estica (168)
SESSION_ABSOLUTE_HOURS=
# cookie só em HTTPS. Por omissão, ligado em produção e desligado fora dela.
# Em produção não pode ser false.
COOKIE_SECURE=
# exigir e-mail verificado para entrar (true). Em produção não pode ser false.
AUTH_REQUIRE_VERIFIED_EMAIL=
# falhas por conta e por origem antes de travar, e a janela em minutos (5, 20, 15)
AUTH_MAX_FAILURES_PER_ACCOUNT=
AUTH_MAX_FAILURES_PER_IP=
AUTH_FAILURE_WINDOW_MINUTES=
# limite próprio das rotas de autenticação, por janela; 0 desliga (10)
AUTH_RATE_LIMIT_MAX=
# validade do link de verificação, em horas (24), e do de recuperação, em minutos (30)
EMAIL_VERIFICATION_TTL_HOURS=
PASSWORD_RESET_TTL_MINUTES=
# base dos links enviados por e-mail (http://127.0.0.1:5173)
PUBLIC_URL=
